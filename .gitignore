# Secrets.
# Note that .gitignore only stops *new* files being added. It does nothing
# about a file that was already committed once — that stays in history until
# the history is rewritten. And `git add -f` overrides it.
.fpkey
.cfkey
.yhid
.yhsecret
*.key
*.pem

# Personal scratch files. Ignored by name because these are exactly where a
# key gets pasted "just for a second" and then forgotten.
notes.md
NOTES.md
notes.txt
secrets.md
scratch.md
TODO.local.md
*.local.md
.env
.env.*

# Licensed FantasyPros data — do NOT publish to a public repo.
# Their exports and the API's free tier are for personal, non-production use;
# pushing them to a public Pages site is redistribution. The app loads these
# at runtime via the file pickers, and localStorage keeps them between
# sessions, so nothing is lost by leaving them out of git.
Fantasy Ranking/
data/players.json
data/raw-response.json

# League draft history — every manager's every pick across seasons. This is
# other people's data in a public repo, and unlike the team names already
# committed it is a behavioural profile. Keep it local.
data/draft-history.json
data/tendencies.json
data/yahoo-raw/

# Regenerable cache of NFL name -> position covering retired players, built by
# tools/fetch_player_positions.py. Only the history parser needs it; the app
# never loads it.
data/player-positions.json

# The synthetic sample CSVs are ours and DO belong in the repo, so the app is
# demoable on a fresh clone:
!data/sample-rankings.csv
!data/sample-adp.csv

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# Local scratch copy — data/strategy.md is the canonical path the app loads.
draft strategy skill

# Generated — run tools/make_design_bundle.py to rebuild.
design-bundle.md

# Yahoo app redirect URI (not a secret, but league-local config).
data/yahoo-app.json

# Saved Yahoo league pages — contain league members' real names and email
# addresses. Parsed locally by tools/parse_yahoo_drafts.py; never published.
data/Yahoo/*.html

# Cached Sleeper season stats for the draft-performance ranking (regenerable).
data/season-stats/
